{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "studio.execution.v1.schema.json",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "studio.execution.v1"
    },
    "storeId": {
      "type": "string",
      "minLength": 1
    },
    "projectId": {
      "type": "string",
      "minLength": 1
    },
    "taskKind": {
      "enum": [
        "plan",
        "produce",
        "verify",
        "preview",
        "visual-plan"
      ]
    },
    "ownerRef": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "proposal",
            "job",
            "preview",
            "visual-plan"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "additionalProperties": false
    },
    "attemptId": {
      "type": "string",
      "minLength": 1
    },
    "runnerId": {
      "type": "string",
      "minLength": 1
    },
    "lease": {
      "type": "object",
      "properties": {
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "expiresAt"
      ],
      "additionalProperties": false
    },
    "profileSnapshot": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "preferencesRevision": {
          "type": "integer",
          "minimum": 0
        },
        "catalogRevision": {
          "type": "integer",
          "minimum": 0
        },
        "modelKey": {
          "type": "string",
          "minLength": 1
        },
        "modelProvider": {
          "type": "string",
          "minLength": 1
        },
        "effort": {
          "enum": [
            "none",
            "minimal",
            "low",
            "medium",
            "high",
            "xhigh",
            "max",
            "ultra"
          ]
        },
        "rolePolicy": {
          "type": "string",
          "minLength": 1
        },
        "contextPolicy": {
          "type": "string",
          "minLength": 1
        },
        "limits": {
          "type": "object",
          "properties": {
            "maxDurationSeconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 7200
            },
            "softTotalTokens": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1,
              "maximum": 2000000
            }
          },
          "required": [
            "maxDurationSeconds",
            "softTotalTokens"
          ],
          "additionalProperties": false
        },
        "runnerId": {
          "type": "string",
          "minLength": 1
        },
        "nativeVersion": {
          "type": "string",
          "minLength": 1
        },
        "environment": {
          "type": [
            "string",
            "object",
            "null"
          ]
        }
      },
      "required": [
        "preferencesRevision",
        "catalogRevision",
        "modelKey",
        "modelProvider",
        "effort",
        "rolePolicy",
        "contextPolicy",
        "limits"
      ],
      "additionalProperties": false
    },
    "inputRefs": {
      "type": "object"
    },
    "scope": {
      "type": "object"
    }
  },
  "required": [
    "schemaVersion",
    "storeId",
    "projectId",
    "taskKind",
    "ownerRef",
    "attemptId",
    "runnerId",
    "lease",
    "inputRefs",
    "scope"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "taskKind": {
            "const": "plan"
          }
        },
        "required": [
          "taskKind"
        ]
      },
      "then": {
        "properties": {
          "profileSnapshot": {
            "type": "object"
          },
          "inputRefs": {
            "type": "object",
            "properties": {
              "sourceAvailable": {
                "type": "boolean"
              },
              "sourceCommit": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "inspectionRef": {
                "type": "string"
              },
              "planningInputRef": {
                "type": "string"
              },
              "assetRefs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "sourceAvailable",
              "sourceCommit",
              "inspectionRef",
              "planningInputRef",
              "assetRefs"
            ],
            "additionalProperties": false
          },
          "scope": {
            "type": "object",
            "properties": {
              "mode": {
                "const": "inspection_only"
              },
              "targetObjectIds": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "allowProjectExecution": {
                "const": false
              }
            },
            "required": [
              "mode",
              "targetObjectIds",
              "allowProjectExecution"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "taskKind": {
            "const": "produce"
          }
        },
        "required": [
          "taskKind"
        ]
      },
      "then": {
        "properties": {
          "profileSnapshot": {
            "type": "object"
          },
          "inputRefs": {
            "type": "object",
            "properties": {
              "packetId": {
                "type": "string"
              },
              "baseCommit": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "inputCommit": {
                "type": "string"
              },
              "inputArtifactRef": {
                "$ref": "#/$defs/artifactRef"
              },
              "gmConfirmationRef": {
                "type": "string"
              },
              "assetRefs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "packetId",
              "baseCommit",
              "inputCommit",
              "inputArtifactRef",
              "gmConfirmationRef",
              "assetRefs"
            ],
            "additionalProperties": false
          },
          "scope": {
            "type": "object",
            "properties": {
              "mode": {
                "const": "private_workspace"
              },
              "allowedFiles": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "allowProjectExecution": {
                "const": false
              }
            },
            "required": [
              "mode",
              "allowedFiles",
              "allowProjectExecution"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "taskKind": {
            "const": "verify"
          }
        },
        "required": [
          "taskKind"
        ]
      },
      "then": {
        "properties": {
          "profileSnapshot": {
            "type": "null"
          },
          "inputRefs": {
            "type": "object",
            "properties": {
              "artifactRef": {
                "$ref": "#/$defs/artifactRef"
              },
              "packetId": {
                "type": "string"
              },
              "inputCommit": {
                "type": "string"
              },
              "sourceCommit": {
                "type": "string"
              }
            },
            "required": [
              "artifactRef",
              "packetId",
              "inputCommit",
              "sourceCommit"
            ],
            "additionalProperties": false
          },
          "scope": {
            "type": "object",
            "properties": {
              "mode": {
                "const": "verification_copy"
              },
              "sourceReadOnly": {
                "const": true
              },
              "cacheScope": {
                "const": ".godot"
              },
              "allowProjectExecution": {
                "const": true
              }
            },
            "required": [
              "mode",
              "sourceReadOnly",
              "cacheScope",
              "allowProjectExecution"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "taskKind": {
            "const": "preview"
          }
        },
        "required": [
          "taskKind"
        ]
      },
      "then": {
        "properties": {
          "profileSnapshot": {
            "type": "null"
          },
          "inputRefs": {
            "type": "object",
            "properties": {
              "artifactRef": {
                "$ref": "#/$defs/artifactRef"
              }
            },
            "required": [
              "artifactRef"
            ],
            "additionalProperties": false
          },
          "scope": {
            "type": "object",
            "properties": {
              "mode": {
                "const": "preview_copy"
              },
              "sourceReadOnly": {
                "const": true
              },
              "cacheScope": {
                "const": ".godot"
              },
              "allowProjectExecution": {
                "const": true
              }
            },
            "required": [
              "mode",
              "sourceReadOnly",
              "cacheScope",
              "allowProjectExecution"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "taskKind": {
            "enum": [
              "plan",
              "produce",
              "visual-plan"
            ]
          }
        },
        "required": [
          "taskKind"
        ]
      },
      "then": {
        "required": [
          "profileSnapshot"
        ],
        "properties": {
          "profileSnapshot": {
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "taskKind": {
            "enum": [
              "verify",
              "preview"
            ]
          }
        },
        "required": [
          "taskKind"
        ]
      },
      "then": {
        "properties": {
          "profileSnapshot": {
            "type": [
              "null",
              "object"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "taskKind": {
            "const": "visual-plan"
          }
        },
        "required": [
          "taskKind"
        ]
      },
      "then": {
        "properties": {
          "profileSnapshot": {
            "type": "object"
          },
          "inputRefs": {
            "type": "object",
            "properties": {
              "visualPlanId": {
                "type": "string",
                "minLength": 1
              },
              "assetRefs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "visualPlanId",
              "assetRefs"
            ],
            "additionalProperties": false
          },
          "scope": {
            "type": "object",
            "properties": {
              "mode": {
                "const": "inspection_only"
              },
              "targetObjectIds": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "allowProjectExecution": {
                "const": false
              }
            },
            "required": [
              "mode",
              "targetObjectIds",
              "allowProjectExecution"
            ],
            "additionalProperties": false
          },
          "ownerRef": {
            "properties": {
              "kind": {
                "const": "visual-plan"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "artifactRef": {
      "type": "object",
      "properties": {
        "artifactId": {
          "type": "string",
          "minLength": 1
        },
        "projectId": {
          "type": "string",
          "minLength": 1
        },
        "jobId": {
          "type": "string",
          "minLength": 1
        },
        "attemptId": {
          "type": "string",
          "minLength": 1
        },
        "sourceCommit": {
          "type": "string",
          "minLength": 1
        },
        "inputCommit": {
          "type": "string",
          "minLength": 1
        },
        "packetId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "artifactId",
        "projectId",
        "jobId",
        "attemptId",
        "sourceCommit",
        "inputCommit",
        "packetId"
      ],
      "additionalProperties": false
    }
  }
}
