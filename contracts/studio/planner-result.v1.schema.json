{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ptah.studio/contracts/studio/planner-result.v1.schema.json",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "studio.planner-result.v1"
    },
    "status": {
      "enum": [
        "NEEDS_CLARIFICATION",
        "READY",
        "BLOCKED"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000
    },
    "questions": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
          },
          "prompt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "type": {
            "enum": [
              "text",
              "choice",
              "number",
              "boolean"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "options": {
            "type": "array",
            "maxItems": 100
          }
        },
        "required": [
          "id",
          "prompt",
          "type",
          "required"
        ],
        "additionalProperties": false
      }
    },
    "document": {
      "oneOf": [
        { "$ref": "objects.v1.schema.json" },
        { "type": "null" }
      ]
    },
    "tasks": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "objectIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
            }
          },
          "requirementIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
            }
          }
        },
        "required": [
          "id",
          "description",
          "objectIds",
          "requirementIds"
        ],
        "additionalProperties": false
      }
    },
    "blockers": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      }
    },
    "feedbackDecisions": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "properties": {
          "feedbackId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
          },
          "status": {
            "enum": [
              "adopted",
              "needs_clarification",
              "deferred",
              "rejected"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "taskIds": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
            }
          },
          "requirementIds": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
            }
          }
        },
        "required": [
          "feedbackId",
          "status",
          "reason",
          "taskIds",
          "requirementIds"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "status",
    "summary",
    "questions",
    "document",
    "tasks",
    "blockers",
    "feedbackDecisions"
  ],
  "additionalProperties": false
}
